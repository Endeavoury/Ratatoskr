{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical protocol vector set v1",
  "description": "Language-independent bytes/events; decoded byte lengths and semantic expectations require independent review.",
  "type": "object",
  "required": [
    "schema_version",
    "template",
    "artifact_id",
    "workflow_id",
    "target",
    "owner_role",
    "status",
    "revision",
    "source_artifacts",
    "assumptions",
    "open_questions",
    "limitations",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template": {
      "type": "boolean"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "const": "vector-designer"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement_refs",
          "category",
          "description",
          "preconditions",
          "logical_input",
          "request_text",
          "response_text",
          "provenance",
          "events",
          "expected",
          "coverage_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "logical_input": {
            "type": "object"
          },
          "request_text": {
            "type": "string"
          },
          "response_text": {
            "type": "string"
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "comparison",
              "fields",
              "state",
              "error",
              "consumed_bytes",
              "output_events"
            ],
            "properties": {
              "comparison": {
                "enum": [
                  "semantic",
                  "exact_bytes",
                  "both"
                ]
              },
              "fields": {
                "type": "object"
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "consumed_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_events": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/event"
                }
              }
            },
            "additionalProperties": false
          },
          "coverage_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED",
        "NEEDS_UPSTREAM_CHANGE",
        "READY_FOR_REVIEW",
        "CHANGES_REQUESTED",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED",
        "COMPLETE"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "revision"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "bytes": {
      "type": "object",
      "required": [
        "encoding",
        "data",
        "byte_length",
        "framing"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "hex",
            "base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "framing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "hex"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "pattern": "^(?:[0-9a-fA-F]{2})*$"
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "actor",
        "at_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "at_ms": {
          "type": "number",
          "minimum": 0
        },
        "payload": {
          "$ref": "#/$defs/bytes"
        },
        "action": {
          "type": "string"
        },
        "expected_after": {
          "type": "object",
          "description": "Optional per-event observations, including state/consumption and component-specific semantic fields.",
          "properties": {
            "state": { "type": ["string", "null"] },
            "error": { "type": ["string", "null"] },
            "consumed_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "fields": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
